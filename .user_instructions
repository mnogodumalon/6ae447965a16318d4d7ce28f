## 4. Template `auswertung` (nur Organisator, mit Login)

Zeigt eine Matrix Teilnehmer mal Optionen mit Summen.

```html
<?code umfrage_id = params.get("umfrage", "")?>
<?code umfrage = None?>
<?for u in datasources.umfrage.app.records.values()?>
	<?if u.id == umfrage_id?><?code umfrage = u?><?end if?>
<?end for?>

<?code optionen = []?>
<?for o in datasources.option.app.records.values()?>
	<?if umfrage is not None and o.v_umfrage.id == umfrage.id?>
		<?code optionen.append(o)?>
	<?end if?>
<?end for?>
<?code optionen = sorted(optionen, key=lambda o: o.v_start)?>

<?code teilnehmerliste = []?>
<?for t in datasources.teilnehmer.app.records.values()?>
	<?if umfrage is not None and t.v_umfrage.id == umfrage.id?>
		<?code teilnehmerliste.append(t)?>
	<?end if?>
<?end for?>

<?code wert = {}?>
<?for a in datasources.antwort.app.records.values()?>
	<?code wert[a.v_teilnehmer.id + "|" + a.v_option.id] = a.v_wert?>
<?end for?>

<!DOCTYPE html>
<html lang="de">
<head>
	<meta charset="utf-8">
	<title>Auswertung</title>
	<style>
		body { font-family: system-ui, sans-serif; margin: 1.5rem; }
		table { border-collapse: collapse; }
		th, td { border: 1px solid #ccc; padding: .4rem .7rem; text-align: center; }
		.ja { background: #d9f2d9; } .vielleicht { background: #fff3c4; } .nein { background: #f6d6d6; }
		.beste { outline: 3px solid #2a7; }
	</style>
</head>
<body>
<?if umfrage is None?>
	<p>Umfrage nicht gefunden.</p>
<?else?>
	<h1>Auswertung: <?print umfrage.v_titel?></h1>
	<?code summe_ja = {}?>
	<?code summe_vl = {}?>
	<?for o in optionen?>
		<?code ja = 0?><?code vl = 0?>
		<?for t in teilnehmerliste?>
			<?code w = wert.get(t.id + "|" + o.id, "")?>
			<?if w == "ja"?><?code ja += 1?><?elif w == "vielleicht"?><?code vl += 1?><?end if?>
		<?end for?>
		<?code summe_ja[o.id] = ja?>
		<?code summe_vl[o.id] = vl?>
	<?end for?>

	<?code beste = None?>
	<?for o in optionen?>
		<?if beste is None or summe_ja[o.id] &gt; summe_ja[beste.id] or (summe_ja[o.id] == summe_ja[beste.id] and summe_vl[o.id] &gt; summe_vl[beste.id])?>
			<?code beste = o?>
		<?end if?>
	<?end for?>

	<table>
		<tr>
			<th>Teilnehmer</th>
			<?for o in optionen?>
				<th <?if beste is not None and o.id == beste.id?>class="beste"<?end if?>><?print o.v_start.format("%d.%m.%Y %H:%M")?></th>
			<?end for?>
		</tr>
		<?for t in teilnehmerliste?>
			<tr>
				<td style="text-align:left"><?print t.v_name?></td>
				<?for o in optionen?>
					<?code w = wert.get(t.id + "|" + o.id, "")?>
					<td class="<?print w?>"><?print w?></td>
				<?end for?>
			</tr>
		<?end for?>
		<tr>
			<th>Ja</th>
			<?for o in optionen?><th><?print summe_ja[o.id]?></th><?end for?>
		</tr>
		<tr>
			<th>Vielleicht</th>
			<?for o in optionen?><th><?print summe_vl[o.id]?></th><?end for?>
		</tr>
	</table>
	<?if beste is not None?>
		<p>Beste Option nach Ja-Stimmen (bei Gleichstand nach Vielleicht): <strong><?print beste.v_start.format("%d.%m.%Y, %H:%M")?> Uhr</strong></p>
	<?end if?>
<?end if?>
</body>
</html>
```

Hinweis: `&lt;` und `&gt;` in den Bedingungen sind HTML-Escapes für `<` und `>`. Falls Ihr Editor sie nicht umwandelt, schreiben Sie dort die normalen Zeichen `<` und `>`, sofern sie in einem `<?if ?>`-Tag stehen.

